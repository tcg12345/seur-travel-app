# Copy this file to .env and add your existing keys there. Never commit .env.
TRIPADVISOR_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Set this only after deploying the backend to an internet-accessible HTTPS address.
PUBLIC_BASE_URL=
HOST=127.0.0.1
PORT=8787
# Optional absolute path to SQLite storage. Back up the database with backup.py.
# AURUM_DATABASE=/persistent-data/aurum.sqlite3

# Server-only Google Places autocomplete (New API)
GOOGLE_PLACES_API_KEY=

# Server-only AeroAPI v4. Enable history only with an entitled plan.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_HISTORY_ENABLED=false
